{
  "name": "sc-stockday-ordering",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server",
    "apps/admin-web",
    "apps/order-web",
    "apps/adapos-sync"
  ],
  "scripts": {
    "build": "npm run build -w apps/admin-web -- --outDir ../../dist/admin-web --emptyOutDir",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w apps/admin-web\" \"npm run dev -w apps/order-web\"",
    "dev:server": "npm run dev -w server",
    "dev:admin": "npm run dev -w apps/admin-web",
    "dev:order": "npm run dev -w apps/order-web",
    "dev:sync": "npm run dev -w apps/adapos-sync",
    "seed": "npm run seed -w server",
    "import:order-workbook": "npm run import:order-workbook -w server --",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "lint": "npm run lint -ws --if-present",
    "test:e2e": "npm --prefix e2e test",
    "sync:ada-agent": "node apps/adapos-sync/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "bcrypt": "^6.0.0"
  }
}
