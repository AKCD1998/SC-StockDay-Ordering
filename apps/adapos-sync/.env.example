# If SQL Server runs on the same machine as this sync agent (the usual setup),
# use 127.0.0.1 instead of the machine's LAN IP. A LAN IP can silently change
# on DHCP lease renewal, which breaks the connection with no warning until the
# next scheduled sync fails — 127.0.0.1 never depends on the network adapter
# at all, so it survives that. Only use a LAN/hostname value here if SQL
# Server genuinely lives on a separate machine from this agent.
ADAPOS_SQLSERVER_HOST=mother-pc-or-sql-host
ADAPOS_SQLSERVER_PORT=1433
ADAPOS_SQLSERVER_USER=readonly_user
ADAPOS_SQLSERVER_PASSWORD=change_me
ADAPOS_SQLSERVER_DATABASE=AdaAcc
ADAPOS_SYNC_INTERVAL_MINUTES=10
ADAPOS_SYNC_DRY_RUN=false
ADAPOS_SYNC_API_BASE_URL=https://paasrtsm-project.onrender.com
ADAPOS_SYNC_SHARED_TOKEN=sc-branch-xxxxxxxxxxxxxxxx
ADAPOS_SYNC_DATE_CUTOFF=2026-12-31
ADAPOS_SYNC_DATASETS=products,sales,sales_detail,branch_stock,transfers,transfer_lines,pending_receipts,approved_receipts
ADAPOS_SYNC_BRANCH_CODE=005
BRANCH_STOCK_SYNC_TOKEN=sc-branch-xxxxxxxxxxxxxxxxx
# Optional. Routine sales_detail window in days (self-heals a missed run).
# Default 7 if unset. Does NOT affect --date-from/--date-to backfill runs.
SALES_DETAIL_LOOKBACK_DAYS=7
# Optional. Add "branch_stock_history" to ADAPOS_SYNC_DATASETS to also post an
# insert-only stock snapshot (for viewing stock history over time) on every run.
# This is additive to branch_stock above (which stays the "current" overwrite
# sync, unchanged) and writes a NEW row every time it runs — only enable it on
# a schedule meant to run a small, fixed number of times per day (e.g. Windows
# Task Scheduler at 08:20/19:20), not on the routine 10-minute loop, or the
# history table will grow unbounded.

# Optional. Max time (ms) to wait for a single API response before aborting.
# Prevents a stalled backend request from hanging the process forever — the
# scheduled task's MultipleInstancesPolicy is "IgnoreNew", so a hung run
# silently blocks every later scheduled run until someone manually kills it.
# Default 60000 (60s) if unset.
ADAPOS_SYNC_REQUEST_TIMEOUT_MS=60000
