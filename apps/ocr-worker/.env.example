# URL of the Render-deployed backend API
API_BASE_URL=https://your-app.onrender.com

# Shared secret — must match OCR_WORKER_KEY on the server
OCR_WORKER_KEY=change-me-to-a-long-random-string

# Local folder the scanner/MFP drops files into
WATCH_FOLDER=C:/Scans/Incoming

# Branch code this mother PC belongs to (default branch for OCR uploads)
DEFAULT_BRANCH_CODE=001

# Polling interval in seconds (watchdog fallback)
POLL_INTERVAL=10
